{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "supabase": ["../../node_modules/@supabase/supabase-js"],
      "zod": ["../../node_modules/zod/index.d.ts"],
      "../_shared/*": ["./_shared/*"]
    },
    "types": [],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "deno.d.ts"]
}
